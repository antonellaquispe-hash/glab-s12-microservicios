            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{pedidoUrl}}/api/pedidos",
            "description": "Guarda IDs y consulta cliente y producto por OpenFeign.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"productoId\": \"{{productoId}}\",\n  \"cantidad\": 2\n}",
